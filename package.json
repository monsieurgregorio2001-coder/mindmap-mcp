{
  "name": "mindmap-mcp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Living Mindmap: a local-first visual knowledge graph with a web UI and an MCP server.",
  "scripts": {
    "dev": "concurrently -k -n api,web -c gray,blue \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "tsx watch src/server/index.ts",
    "dev:web": "vite",
    "build": "vite build",
    "start": "npm run build && tsx src/server/index.ts",
    "mcp": "tsx src/mcp/index.ts",
    "seed": "tsx src/core/seed-cli.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "vitest run",
    "e2e": "node scripts/e2e.mjs",
    "verify:mcp": "tsx scripts/verify-mcp.ts",
    "bench": "tsx scripts/bench.ts",
    "screenshot": "node scripts/screenshot.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.31.0",
    "@xyflow/react": "^12.12.0",
    "better-sqlite3": "^12.11.1",
    "express": "^5.2.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/better-sqlite3": "^9.6.0",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^4.7.0",
    "concurrently": "^9.2.4",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "prettier": "^3.9.9",
    "puppeteer-core": "^24.43.1",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^5.4.21",
    "vitest": "^2.1.9"
  },
  "author": "Garfield Greg Lim III",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  }
}
